          },
          "401": {
            "description": "401 Unauthorized - Sin token"
          }
        },
        "tags": [
          "Disponibilidad"
        ]
      }
    },
    "/api/disponibilidad/2": {
      "get": {
        "summary": "Obtener disponibilidad de otro usuario",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{token}}"
          }
        ],
        "responses": {
          "200": {
            "description": "200 OK"
          },
          "401": {
            "description": "401 Unauthorized - Sin token"
          }
        },
        "tags": [
          "Disponibilidad"
        ]
      }
    },
    "/api/perfil/99999": {
      "get": {
        "summary": "[ATAQUE] Perfil con ID inexistente (404)",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{token}}"
          }
        ],
        "responses": {
          "404": {
            "description": "404 Not Found - ID no existe en la base de datos"
          }
        },
        "tags": [
          "Seguridad - Ataques para defensa"
        ]
      }
    },
    "/api/health": {
      "get": {
        "summary": "Verificar estado del servidor",
        "responses": {
          "200": {
            "description": "200 OK"
          }
        },
        "tags": [
          "Health Check"
        ]
      }
    }
  }
}