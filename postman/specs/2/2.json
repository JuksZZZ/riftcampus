        "responses": {
          "200": {
            "description": "200 OK - Lista paginada de matches"
          },
          "401": {
            "description": "401 Unauthorized - Sin token"
          }
        },
        "tags": [
          "Matches"
        ]
      }
    },
    "/api/leaderboard": {
      "get": {
        "summary": "Obtener ranking (paginado)",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10
          },
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{token}}"
          }
        ],
        "responses": {
          "200": {
            "description": "200 OK - Tabla de ranking con posición"
          },
          "401": {
            "description": "401 Unauthorized - Sin token"
          }
        },
        "tags": [
          "Leaderboard"
        ]
      }
    },
    "/api/disponibilidad": {
      "get": {
        "summary": "Obtener mi disponibilidad",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
